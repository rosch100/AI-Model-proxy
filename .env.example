# Public DNS names for the self-hosted Caddy reverse proxy. Every name must
# resolve to this server's public IP; Caddy issues and renews certificates.
PUBLIC_HOSTNAMES=proxy.altanis.de, proxy.iffm-gmbh.de

# Environment variables for local development
FLASK_APP=autoapp.py
FLASK_DEBUG=1
FLASK_ENV=development
GUNICORN_WORKERS=1
# Local/dev default. docker compose `flask` uses ${LOG_LEVEL:-warning}.
LOG_LEVEL=debug
LOG_CONTEXT=off
LOG_COMPLETION=off
# Keep off in production; completed streams still rewrite large SSE fixtures.
RECORD_TRAFFIC=off
# Reasoning display mode:
# - none: hide thinking text in Cursor, preserve native reasoning metadata only.
# - mdthinkblocks: experimental Markdown <details> fallback. This can look bad,
#   is new/unstable, and may fail to show thinking consistently.
# - thinkblocks: legacy visible <think>...</think> chat content.
REASONING_DISPLAY_MODE=mdthinkblocks

# Required in AUTH_MODE=single: generate a secret with
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`
AUTH_MODE=single
SERVICE_API_KEY=

# AUTH_MODE=tenant uses per-tenant API key hashes and Azure credentials.
# Generate a tenant key + hash with:
#   python -c "import hashlib,secrets; k=secrets.token_urlsafe(32); print(k); print(hashlib.sha256(k.encode()).hexdigest())"
# Put the cleartext key into Cursor; store only the hash below. Inject each
# tenant's Azure API key via the env var named by azure_api_key_env (never commit it).
# Each tenant MUST declare its own azure_model_deployments map (Cursor model id →
# that tenant's Azure deployment name). Global AZURE_MODEL_DEPLOYMENTS is ignored
# in tenant mode; tenants never share or inherit each other's model list.
# Example with two tenants and different Azure deployments:
# TENANTS=[{"id":"acme","api_key_hash":"<sha256-hex>","azure_base_url":"https://acme.openai.azure.com","azure_api_key_env":"TENANT_ACME_AZURE_API_KEY","azure_model_deployments":{"gpt-5.6-sol":"acme-sol","gpt-5.5":"acme-gpt55"}},{"id":"beta","api_key_hash":"<sha256-hex>","azure_base_url":"https://beta.openai.azure.com","azure_api_key_env":"TENANT_BETA_AZURE_API_KEY","azure_model_deployments":{"gpt-5.6-luna":"beta-luna"}}]
# TENANT_ACME_AZURE_API_KEY=
# TENANT_BETA_AZURE_API_KEY=
TENANTS=
# Select `database` only after PostgreSQL schema migration and tenant bootstrap.
# Database mode rejects TENANTS; import the legacy TENANTS JSON using the CLI first.
TENANT_CONFIG_SOURCE=environment
DATABASE_URL=
# Generate a URL-safe base64-encoded 32-byte key and store outside the database.
# PROVIDER_ENCRYPTION_KEY=
# Opaque admin cookie + Flask CSRF signing secret (at least 32 random bytes).
# ADMIN_SESSION_SECRET=
# WebAuthn relying party for /admin passkeys (required in database mode).
# WEBAUTHN_RP_ID=proxy.altanis.de
# WEBAUTHN_RP_NAME=Altanis Proxy
# WEBAUTHN_ORIGINS=https://proxy.altanis.de,https://proxy.iffm-gmbh.de

# Provider switches. Root and /azure use Azure; /codex uses Codex.
ENABLE_AZURE=true
ENABLE_CODEX=false

# Mandatory Azure settings
AZURE_BASE_URL=https://azureopenai-instanz2.cognitiveservices.azure.com
AZURE_API_KEY=change-me

# Map Cursor-facing model IDs to the AzureOpenAI-Instanz2 deployment names.
AZURE_MODEL_DEPLOYMENTS={"gpt-6-astra":"gpt-6-astra-api","gpt-6-luna":"gpt-6-luna-api","gpt-6.1-sol":"gpt-6.1-sol-api"}

# Optional Azure settings
AZURE_SUMMARY_LEVEL=
AZURE_VERBOSITY_LEVEL=
AZURE_TRUNCATION=

# Optional Codex provider settings. Enable Codex only after `codex login`.
CODEX_AUTH_PATH=~/.codex/auth.json
CODEX_RESPONSES_URL=https://chatgpt.com/backend-api/codex/responses
CODEX_SUPPORTED_MODELS=gpt-5.5,gpt-5.4,gpt-5.4-mini,gpt-5.3-codex,gpt-5.3-codex-spark
CODEX_MODEL_REWRITES=
CODEX_ORIGINATOR=codex_cli_rs
CODEX_USER_AGENT="codex_cli_rs/0.130.0 cursor-provider-proxy/0.1"
# Set true if Cursor omits conversation markers on some requests (see README Troubleshooting).
CODEX_DISCOVERY_MODE=false
CODEX_TOKEN_REFRESH_SKEW_SECONDS=300
CODEX_REQUEST_TIMEOUT_SECONDS=600
